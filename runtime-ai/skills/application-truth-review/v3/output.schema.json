{
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "status", "segments"],
        "properties": {
          "item_id": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "BLOCK"]},
          "segments": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "kind", "claim_ids"],
              "properties": {
                "text": {"type": "string"},
                "kind": {"type": "string", "enum": ["FACTUAL", "NON_FACTUAL"]},
                "claim_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
