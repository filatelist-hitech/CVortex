{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "importance", "label", "normalized_value", "source_excerpt", "confidence"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["TECHNICAL", "EXPERIENCE", "DOMAIN", "LANGUAGE", "LOCATION", "WORK_FORMAT", "SALARY"]
          },
          "importance": {
            "type": "string",
            "enum": ["MANDATORY", "PREFERRED", "UNCERTAIN"]
          },
          "label": {"type": "string"},
          "normalized_value": {"type": ["string", "null"]},
          "source_excerpt": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
