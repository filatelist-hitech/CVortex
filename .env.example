# ==============================================================================
# CVortex Environment Configuration Reference
# ==============================================================================
# ARCHITECTURAL INVARIANT (ADR-0027):
# Variables marked [BOOTSTRAP/ENV_ONLY] are immutable container & infrastructure
# settings. The application NEVER alters .env at runtime.
# Variables marked [RUNTIME_FALLBACK] serve as initial/deployment fallbacks for
# the SettingDefinitionRegistry and can be safely overridden at runtime by
# administrators via the Administration -> System Settings UI (/admin/settings).
# ==============================================================================

# [BOOTSTRAP/ENV_ONLY] Edge & Network Bindings
CVORTEX_PORT=8080
ALLOWED_DEV_ORIGINS=

# [BOOTSTRAP/ENV_ONLY] Application Core
APP_NAME=CVortex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# [RUNTIME_FALLBACK] AI Defaults & System-managed Providers (Override via /admin/settings)
AI_PROVIDER=none
AI_HTTP_PROXY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CAREER_EXTRACTION_MODEL=
OPENAI_APPLICATION_DRAFT_MODEL=
OPENAI_APPLICATION_INPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_APPLICATION_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_CAREER_INPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_CAREER_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CAREER_EXTRACTION_MODEL=gemini-1.5-flash
GEMINI_APPLICATION_DRAFT_MODEL=gemini-1.5-flash
GEMINI_INPUT_COST_MICROS_PER_MILLION_TOKENS=
GEMINI_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
GEMINI_TIMEOUT_SECONDS=45

# [BOOTSTRAP/ENV_ONLY] Inbound MCP & OAuth Gateway
MCP_ENABLED=false
CHATGPT_PLAN_ENABLED=false
CHATGPT_CALLBACK_URI=http://127.0.0.1:8080/api/v1/chatgpt/callback
# Exact OAuth resource identifier (defaults to APP_URL/mcp/v1; non-secret).
# For Secure MCP Tunnel, configure the exact resource from its OAuth request locally.
# Keep APP_URL/issuer local; never commit a real tunnel-specific URL.
MCP_RESOURCE_URL=
# Optional OAuth issuer (defaults to APP_URL; non-secret).
MCP_AUTHORIZATION_SERVER_URL=

# [BOOTSTRAP/ENV_ONLY] Logging & Retention
LOG_LEVEL=debug
DIAGNOSTIC_OCCURRENCE_DAYS=30
DIAGNOSTIC_CLOSED_DAYS=90
QUEUE_FAILED_DRIVER=null

# [BOOTSTRAP/ENV_ONLY] Security, Session & Stateful Auth
SESSION_SECURE_COOKIE=false
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_DECAY_SECONDS=60
HASH_DRIVER=argon2id
HASH_VERIFY=true
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:18080,127.0.0.1:8080,127.0.0.1:18080,__SANCTUM_CURRENT_REQUEST_HOST__

# [BOOTSTRAP/ENV_ONLY] Database Infrastructure (PostgreSQL)
POSTGRES_DB=cvortex
POSTGRES_USER=cvortex
POSTGRES_PASSWORD=generated-by-make-init
POSTGRES_RUNTIME_USER=cvortex_app
POSTGRES_RUNTIME_PASSWORD=generated-by-make-init-runtime

# [BOOTSTRAP/ENV_ONLY] Redis Infrastructure
REDIS_DB=0
REDIS_CACHE_DB=1
