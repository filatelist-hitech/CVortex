CVORTEX_PORT=8080

APP_NAME=CVortex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CAREER_EXTRACTION_MODEL=
OPENAI_CAREER_INPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_CAREER_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
OPENAI_TIMEOUT_SECONDS=45
LOG_LEVEL=debug
SESSION_SECURE_COOKIE=false
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_DECAY_SECONDS=60
HASH_DRIVER=argon2id
HASH_VERIFY=true
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:18080,127.0.0.1:8080,127.0.0.1:18080,__SANCTUM_CURRENT_REQUEST_HOST__

POSTGRES_DB=cvortex
POSTGRES_USER=cvortex
POSTGRES_PASSWORD=generated-by-make-init
POSTGRES_RUNTIME_USER=cvortex_app
POSTGRES_RUNTIME_PASSWORD=generated-by-make-init-runtime

REDIS_DB=0
REDIS_CACHE_DB=1
